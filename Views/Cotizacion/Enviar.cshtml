@model WinMovers.Models.EnviarCotizacionViewModel

@{
    ViewData["Title"] = "Enviar Cotización";
}

<div class="form-header">
    <h2 class="content-title">
        <i class="fas fa-paper-plane"></i>
        Enviar Cotización <span class="numero-cotizacion">@Model.NumeroCotizacion</span>
    </h2>

    <a asp-action="Details" asp-route-id="@Model.IdCotizacion" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Volver
    </a>
</div>

<form asp-action="Enviar" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdCotizacion" />
    <input type="hidden" asp-for="NumeroCotizacion" />
    <input type="hidden" asp-for="NombreCliente" />

    <div asp-validation-summary="ModelOnly" class="alert-error"></div>

    <div class="form-card">
        <h3 class="form-subtitle"><i class="fas fa-envelope"></i> Datos del envío</h3>

        <div class="form-row two-cols">
            <div class="form-group">
                <label asp-for="Destinatario"></label>
                <input asp-for="Destinatario" type="email" placeholder="cliente@ejemplo.com" />
                <span asp-validation-for="Destinatario" class="field-error"></span>
                <span class="form-hint">Se enviará la cotización de <strong>@Model.NombreCliente</strong>.</span>
            </div>

            <div class="form-group">
                <label asp-for="Asunto"></label>
                <input asp-for="Asunto" />
                <span asp-validation-for="Asunto" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="MensajeAdicional"></label>
            <textarea asp-for="MensajeAdicional" rows="4"
                      placeholder="Se mostrará resaltado al inicio del correo, antes del machote."></textarea>
            <span class="form-hint">Opcional. Útil para agregar contexto o dar seguimiento.</span>
        </div>

        <div class="aviso-previa">
            <i class="fas fa-info-circle"></i>
            <span>
                El correo llevará el machote completo con la tarifa, el cronograma y las condiciones.
                <a asp-action="VistaPrevia" asp-route-id="@Model.IdCotizacion" target="_blank">
                    Ver vista previa
                </a>
                antes de enviarlo.
            </span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-paper-plane"></i> Enviar Cotización
        </button>
        <a asp-action="Details" asp-route-id="@Model.IdCotizacion" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
