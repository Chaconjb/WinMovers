@model WinMovers.Models.Cotizacion

@{
    ViewData["Title"] = "Editar Cotización";
}

<div class="form-header">
    <h2 class="content-title">
        <i class="fas fa-edit"></i>
        Editar Cotización
        <span class="numero-cotizacion">@Model.NumeroCotizacion</span>
    </h2>

    <div class="header-acciones">
        <a asp-action="Details" asp-route-id="@Model.IdCotizacion" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>
</div>

@if (Model.Estado == EstadosCotizacion.Enviada)
{
    <div class="alert-info">
        <i class="fas fa-paper-plane"></i>
        Esta cotización ya fue enviada a <strong>@Model.CorreoEnvio</strong>
        el @Model.FechaEnvio?.ToString("dd/MM/yyyy 'a las' HH:mm").
        Si cambias los montos, deberás <strong>volver a enviarla</strong> para que el cliente
        reciba la versión corregida.
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.IdCotizacion" method="post" id="formCotizacion">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdCotizacion" />
    <input type="hidden" asp-for="NumeroCotizacion" />
    <input type="hidden" asp-for="Moneda" />
    <input type="hidden" asp-for="Estado" />

    <partial name="_Formulario" model="Model" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Guardar Cambios
        </button>
        <a asp-action="Details" asp-route-id="@Model.IdCotizacion" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cotizacion-calculadora.js" asp-append-version="true"></script>
}
