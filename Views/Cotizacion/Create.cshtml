@model WinMovers.Models.Cotizacion

@{
    ViewData["Title"] = "Nueva Cotización";
}

<div class="form-header">
    <h2 class="content-title">
        <i class="fas fa-file-invoice-dollar"></i>
        Nueva Cotización
        <span class="numero-cotizacion">@Model.NumeroCotizacion</span>
    </h2>

    <a asp-action="Index" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i> Volver
    </a>
</div>

<form asp-action="Create" method="post" id="formCotizacion">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="NumeroCotizacion" />
    <input type="hidden" asp-for="Moneda" />

    <partial name="_Formulario" model="Model" />

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Guardar Cotización
        </button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cotizacion-calculadora.js" asp-append-version="true"></script>
}
