@model WinMovers.Models.OrdenTrabajo

@{
    ViewData["Title"] = "Inventario de Bienes";
}

<div class="form-header">

    <h2 class="content-title">
        <i class="fas fa-couch"></i>
        Inventario de Bienes
    </h2>

    <a asp-controller="OrdenTrabajo" asp-action="Index" class="btn btn-outline">
        <i class="fas fa-arrow-left"></i>
        Volver
    </a>

</div>

@* El _Layout sólo pinta TempData["Success"], así que el aviso de error
   (bien duplicado, datos inválidos) se renderiza aquí. *@
@if (TempData["Error"] != null)
{
    <div class="toast show error" style="margin-bottom:15px;">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<!-- Información de la Orden -->

<div class="form-card" style="margin-bottom:20px;">

    <div class="form-row three-cols">

        <div>
            <strong>O.T.:</strong>
            @Model.NumeroOT
        </div>

        <div>
            <strong>Cliente:</strong>
            @Model.NombreCliente
        </div>

        <div>
            <strong>Fecha Servicio:</strong>
            @(Model.FechaServicio?.ToString("dd/MM/yyyy") ?? "—")
        </div>

        <div>
            <strong>Estado:</strong>
            @Model.Estado
        </div>

    </div>

</div>

<!-- Alta de un bien -->

<div class="form-card">

    <h4 style="margin-bottom:20px;">
        Registrar bien del cliente
    </h4>

    <form asp-controller="BienMudanza" asp-action="Registrar" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" name="IdOrden" value="@Model.IdOrden" />

        <div class="form-row three-cols">

            <div class="form-group">

                <label>Bien</label>

                <input type="text"
                       name="NombreBien"
                       maxlength="150"
                       required
                       placeholder="Ej. Refrigeradora"
                       class="form-control" />

            </div>

            <div class="form-group">

                <label>Cantidad</label>

                <input type="number"
                       name="Cantidad"
                       min="1"
                       value="1"
                       required
                       class="form-control" />

            </div>

            <div class="form-group">

                <label>Condición</label>

                <select name="Condicion" class="form-control">

                    @foreach (var condicion in WinMovers.Models.CondicionesBien.Todas)
                    {
                        <option value="@condicion">@condicion</option>
                    }

                </select>

            </div>

        </div>

        <div class="form-row">

            <div class="form-group">

                <label>Descripción</label>

                <input type="text"
                       name="Descripcion"
                       maxlength="250"
                       placeholder="Marca, modelo, color…"
                       class="form-control" />

            </div>

        </div>

        <div class="form-row">

            <div class="form-group">

                <label>Observaciones</label>

                <textarea name="Observaciones"
                          maxlength="500"
                          rows="2"
                          placeholder="Rayones, piezas sueltas, embalaje especial…"
                          class="form-control"></textarea>

            </div>

        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            Registrar bien
        </button>

    </form>

</div>

<!-- Bienes registrados -->

<div class="table-container" style="margin-top:25px;">

    <table class="data-table">

        <thead>

            <tr>

                <th>Bien</th>

                <th>Descripción</th>

                <th>Cantidad</th>

                <th>Condición</th>

                <th>Observaciones</th>

                <th>Registrado</th>

                <th>Acciones</th>

            </tr>

        </thead>

        <tbody>

            @if (Model.Bienes == null || !Model.Bienes.Any())
            {
                <tr>

                    <td colspan="7" class="no-data">

                        No hay bienes registrados en esta orden.

                    </td>

                </tr>
            }
            else
            {
                @foreach (var bien in Model.Bienes)
                {
                    <tr>

                        <td>@bien.NombreBien</td>

                        <td>@(string.IsNullOrWhiteSpace(bien.Descripcion) ? "—" : bien.Descripcion)</td>

                        <td>@bien.Cantidad</td>

                        <td>@bien.Condicion</td>

                        <td>@(string.IsNullOrWhiteSpace(bien.Observaciones) ? "—" : bien.Observaciones)</td>

                        <td>@bien.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>

                        <td>

                            <form asp-controller="BienMudanza"
                                  asp-action="Eliminar"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="idBien" value="@bien.IdBien" />

                                <input type="hidden" name="idOrden" value="@Model.IdOrden" />

                                <button type="submit"
                                        class="btn-icon delete"
                                        title="Eliminar bien"
                                        onclick="return confirm('¿Desea eliminar el bien &quot;@bien.NombreBien&quot; de esta orden?')">

                                    <i class="fas fa-trash"></i>

                                </button>

                            </form>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>
