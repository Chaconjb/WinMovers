<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WinMovers</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/winmovers.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/winmovers-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cotizaciones.css" asp-append-version="true" />
</head>

	@{
	var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
	var accion = ViewContext.RouteData.Values["action"]?.ToString();
	var enGestionUsuarios = ctrl == "Usuario" || ctrl == "Rol";
	}

	<body>

		<!-- SIDEBAR -->
		@if (User.Identity != null && User.Identity.IsAuthenticated)
		{
		<aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <i class="fas fa-truck-moving sidebar-logo-icon"></i>
                <h2>WinMovers</h2>
            </div>
            <span class="sidebar-subtitle">Local and International Relocations</span>
        </div>

        <nav class="sidebar-nav">
            <ul>
                <li>
                    <a asp-controller="Dashboards" asp-action="Index"
                       class="sidebar-link @(ctrl == "Dashboards" ? "active" : "")">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Cliente" asp-action="Index"
                       class="sidebar-link @(ctrl == "Cliente" ? "active" : "")">
                        <i class="fas fa-users"></i>
                        <span>Clientes</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Cotizacion" asp-action="Index"
                       class="sidebar-link @(ctrl == "Cotizacion" ? "active" : "")">
                        <i class="fas fa-file-invoice-dollar"></i>
                        <span>Cotizaciones</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="OrdenTrabajo" asp-action="Index"
                       class="sidebar-link @(ctrl == "OrdenTrabajo" ? "active" : "")">
                        <i class="fas fa-clipboard-list"></i>
                        <span>Órdenes de Trabajo</span>
                    </a>
                </li>
                    <li>
                        <a asp-controller="Inventario" asp-action="Index"
                           class="sidebar-link @(ctrl == "Inventario" ? "active" : "")">
                            <i class="fas fa-boxes"></i>
                            <span>Inventario</span>
                        </a>
                    </li>
                <li>
                    <a asp-controller="ControlVisita" asp-action="Index"
                       class="sidebar-link @(ctrl == "ControlVisita" ? "active" : "")">
                        <i class="fas fa-calendar-check"></i>
                        <span>Control de Visitas</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Exportacion" asp-action="Index"
                       class="sidebar-link @(ctrl == "Exportacion" ? "active" : "")">
                        <i class="fas fa-file-export"></i>
                        <span>Exportación</span>
                    </a>
                </li>
				<li>
					<a asp-controller="Importacion" asp-action="Index"
                       class="sidebar-link @(ctrl == "Importacion=" ? "active=" : "")">
						<i class="fas fa-file-import"></i>
						<span>Importación</span>
					</a>
				</li>
				<li>
					<a asp-controller="Dashboards" asp-action="Analitica"
                       class="sidebar-link @(accion == "Analitica=" ? "active=" : "")">
						<i class="fas fa-chart-line"></i>
						<span>Analítica</span>
					</a>
				</li>
				<li>
					<a asp-controller="Dashboards" asp-action="Historico"
                       class="sidebar-link @(accion == "Historico=" ? "active=" : "")">
						<i class="fas fa-clock-rotate-left"></i>
						<span>Histórico</span>
					</a>
				</li>
				<li>
					<a asp-controller="Dashboards" asp-action="Estadisticas"
                       class="sidebar-link @(accion == "Estadisticas=" ? "active=" : "")">
						<i class="fas fa-chart-pie"></i>
						<span>Estadísticas</span>
					</a>
				</li>
				<li>
					<a asp-controller="Dashboards" asp-action="Pronostico"
                       class="sidebar-link @(accion == "Pronostico=" ? "active=" : "")">
						<i class="fas fa-wand-magic-sparkles"></i>
						<span>Pronóstico</span>
					</a>
				</li>
				@if (User.IsInRole("Administrador"))
				{
				<li>
					<a asp-controller="Usuario" asp-action="Index"
					   class="sidebar-link @(enGestionUsuarios ? "active=" : "")">
						<i class="fas fa-user-cog"></i>
						<span>Gestión de Usuarios</span>
					</a>
				</li>
				}
			</ul>
		</nav>

			<div class="sidebar-footer">
				<p>
					<i class="fas fa-phone"></i> (506) 2215-3536
				</p>
				<p>
					<i class="fas fa-envelope"></i> sales@winmovers.com
				</p>
			</div>
		</aside>
		}

		<!-- MAIN WRAPPER -->
    <div class="main-wrapper">
        <header class="topbar">
            <button class="sidebar-toggle" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>
            <h1 class="page-title">
                <i class="fas fa-truck-moving"></i>
                @ViewData["Title"]
            </h1>
            <div class="topbar-right">
                <span class="topbar-date" id="currentDate"></span>
				<div class="topbar-user">
					<i class="fas fa-user-circle"></i>
					@if (User.Identity != null && User.Identity.IsAuthenticated)
					{
					<span>@User.FindFirst("NombreCompleto")?.Value</span>
					<form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
						<button type="submit" class="sidebar-link" style="background:none;border:none;cursor:pointer;">
							<i class="fas fa-sign-out-alt"></i>
						</button>
					</form>
					}
					else
					{
					<span>Invitado</span>
					}
				</div>
            </div>
        </header>

        <main class="main-content">

            @* Mensajes de éxito *@
            @if (TempData["Success"] != null)
            {
                <div class="toast show success" id="toastMsg">
                    <i class="fas fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            @* Mensajes de error. Los toasts son position:fixed en la misma
               esquina, así que si además hay uno de éxito este se sube para
               que no queden encimados. *@
            @if (TempData["Error"] != null)
            {
                <div class="toast show error" id="toastErr"
                     style="bottom:@(TempData["Success"] != null ? "92px" : "30px");">
                    <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        // Fecha en topbar
        document.getElementById('currentDate').textContent =
            new Date().toLocaleDateString('es-CR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

        // Sidebar toggle (responsive)
        document.getElementById('sidebarToggle').addEventListener('click', () => {
            document.getElementById('sidebar').classList.toggle('active');
        });

        // Auto-ocultar toasts (éxito y error)
        setTimeout(() => {
            document.querySelectorAll('.toast.show')
                .forEach(t => t.classList.remove('show'));
        }, 3500);
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
