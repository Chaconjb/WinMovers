@{
    ViewData["Title"] = "Contraseña actualizada";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">
        <h2 class="mb-3 text-success">@(TempData["Success"] ?? "La contraseña ha sido cambiada exitosamente.")</h2>
        <a asp-action="Login" class="btn btn-primary mt-3">Iniciar sesión</a>
    </div>
</div>