@{
    ViewData["Title"] = "Contraseña actualizada";
    Layout = "_LayoutAuth";
}

<div class="auth-icon-result success">
    <i class="fas fa-circle-check"></i>
</div>
<h2>@(TempData["Success"] ?? "La contraseña ha sido cambiada exitosamente.")</h2>

<a asp-action="Login" class="auth-btn" style="display:block; text-align:center; text-decoration:none; margin-top: 10px;">
    Iniciar sesión
</a>
