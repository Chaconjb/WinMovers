@model WinMovers.Models.CambiarContrasenaTemporalViewModel
@{
    ViewData["Title"] = "Cambio de contraseña obligatorio";
    Layout = "_LayoutAuth";
}

<h2>Debes cambiar tu contraseña</h2>
<p class="auth-subtitle">Iniciaste sesión con una contraseña temporal</p>

<div class="auth-info-box">
    <i class="fas fa-info-circle"></i>
    <span>Por seguridad, crea una nueva contraseña antes de continuar usando el sistema.</span>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="auth-error-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="CambiarContrasenaTemporal" method="post">
    <div class="form-group">
        <label asp-for="NuevaContrasena"></label>
        <input asp-for="NuevaContrasena" autofocus autocomplete="new-password" />
        <span asp-validation-for="NuevaContrasena" class="auth-field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmarContrasena"></label>
        <input asp-for="ConfirmarContrasena" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarContrasena" class="auth-field-error"></span>
    </div>

    <button type="submit" class="auth-btn">
        <i class="fas fa-key"></i> Guardar nueva contraseña
    </button>
</form>
