@model WinMovers.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
}

<h2>Iniciar sesión</h2>
<p class="auth-subtitle">Ingresa tus credenciales para acceder al sistema</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="auth-error-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="form-group">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" autofocus autocomplete="username" />
        <span asp-validation-for="Correo" class="auth-field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Contrasena"></label>
        <input asp-for="Contrasena" autocomplete="current-password" />
        <span asp-validation-for="Contrasena" class="auth-field-error"></span>
    </div>

    <label class="auth-checkbox">
        <input asp-for="RecordarMe" />
        <span>Recordarme</span>
    </label>

    <button type="submit" class="auth-btn">
        <i class="fas fa-sign-in-alt"></i> Iniciar sesión
    </button>

    <div class="auth-links">
        <a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a>
    </div>


    <div class="auth-links mt-3">

        <span>¿No tienes una cuenta?</span><br />

        <a asp-action="CrearCuenta">Crear una cuenta</a>

    </div>
</form>
