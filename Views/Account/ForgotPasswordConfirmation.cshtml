@model WinMovers.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutAuth";
}

<h2>Recuperar contraseña</h2>
<p class="auth-subtitle">Ingresa tu correo y te enviaremos instrucciones para restablecerla</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="auth-error-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="ForgotPassword" method="post">
    <div class="form-group">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" autofocus autocomplete="username" />
        <span asp-validation-for="Correo" class="auth-field-error"></span>
    </div>

    <button type="submit" class="auth-btn">
        <i class="fas fa-paper-plane"></i> Enviar instrucciones
    </button>

    <div class="auth-links">
        <a asp-action="Login">Volver a iniciar sesión</a>
    </div>
</form>
