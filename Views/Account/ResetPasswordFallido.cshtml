@{
    ViewData["Title"] = "Enlace inválido";
    Layout = "_LayoutAuth";
}

<div class="auth-icon-result warning">
    <i class="fas fa-triangle-exclamation"></i>
</div>
<h2>El enlace ha expirado o no es válido</h2>
<p class="auth-subtitle">Solicita un nuevo enlace de recuperación de contraseña</p>

<a asp-action="ForgotPassword" class="auth-btn" style="display:block; text-align:center; text-decoration:none;">
    Solicitar nueva recuperación
</a>
