@{
    ViewData["Title"] = "Enlace inválido";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">
        <h2 class="mb-3 text-warning">El enlace ha expirado o no es válido</h2>
        <p>Solicita un nuevo enlace de recuperación de contraseña.</p>
        <a asp-action="ForgotPassword" class="btn btn-primary mt-3">Solicitar nueva recuperación</a>
    </div>
</div>