@model WinMovers.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h2 class="mb-4">Recuperar contraseña</h2>
        <p class="text-muted">Ingresa tu correo y te enviaremos instrucciones para restablecer tu contraseña.</p>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" autofocus />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Enviar instrucciones</button>

            <div class="mt-3 text-center">
                <a asp-action="Login">Volver a iniciar sesión</a>
            </div>
        </form>
    </div>
</div>