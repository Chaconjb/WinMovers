@model WinMovers.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_LayoutAuth";
}

<h2>Restablecer contraseña</h2>
<p class="auth-subtitle">Crea una nueva contraseña para tu cuenta</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="auth-error-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="Correo" />
    <input type="hidden" asp-for="Token" />

    <div class="form-group">
        <label asp-for="NuevaContrasena"></label>
        <input asp-for="NuevaContrasena" autofocus autocomplete="new-password" />
        <span asp-validation-for="NuevaContrasena" class="auth-field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmarContrasena"></label>
        <input asp-for="ConfirmarContrasena" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarContrasena" class="auth-field-error"></span>
    </div>

    <button type="submit" class="auth-btn">
        <i class="fas fa-key"></i> Cambiar contraseña
    </button>
</form>
