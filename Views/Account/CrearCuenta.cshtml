@model WinMovers.Models.CrearCuentaViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_LayoutAuth";
}

<h2>Crear cuenta</h2>
<p class="auth-subtitle">Completa tus datos para registrarte en el sistema</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="auth-error-summary">
        <div asp-validation-summary="ModelOnly"></div>
    </div>
}

<form asp-action="CrearCuenta" method="post">
    <div class="form-group">
        <label asp-for="NombreCompleto"></label>
        <input asp-for="NombreCompleto" autofocus placeholder="Nombre completo" />
        <span asp-validation-for="NombreCompleto" class="auth-field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" placeholder="correo@email.com" autocomplete="username" />
        <span asp-validation-for="Correo" class="auth-field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Contrasena"></label>
        <input asp-for="Contrasena" placeholder="Contraseña" autocomplete="new-password" />
        <span asp-validation-for="Contrasena" class="auth-field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmarContrasena"></label>
        <input asp-for="ConfirmarContrasena" placeholder="Confirmar contraseña" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarContrasena" class="auth-field-error"></span>
    </div>

    <button type="submit" class="auth-btn">
        <i class="fas fa-user-plus"></i> Crear cuenta
    </button>

    <div class="auth-links">
        <a asp-action="Login">¿Ya tiene una cuenta? Iniciar sesión</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
